<Window x:Class="WpfApp1.Nakladnye"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Nakladnye" Height="650" Width="950" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <DataGrid x:Name="NakladnyeDataGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30,0,0" Width="890" Height="480" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                <DataGridTextColumn Header="Номер накладной" Binding="{Binding nomer}" Width="200"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding data_nakladnoy}" Width="150"/>
                <DataGridTextColumn Header="Контрагент" Binding="{Binding kontragent}" Width="300"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding tip}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="BackBTN" Content="Назад" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,540,0,0" Width="180" Height="45" Background="Transparent" Foreground="#4F46E5" Click="BackBTN_Click"/>
    </Grid>
</Window>