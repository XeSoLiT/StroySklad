<Window x:Class="WpfApp1.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Menu" Height="700" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Label x:Name="UserInfoLBL" Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" FontSize="16"/>
        <Button x:Name="MaterialsBTN" Content="Материалы" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,100,0,0" Width="300" Height="45" Click="MaterialsBTN_Click"/>
        <Button x:Name="ClientsBTN" Content="Клиенты" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0" Width="300" Height="45" Click="ClientsBTN_Click"/>
        <Button x:Name="PostavshikiBTN" Content="Поставщики" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,220,0,0" Width="300" Height="45" Click="PostavshikiBTN_Click"/>
        <Button x:Name="NakladnyeBTN" Content="Накладные" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,280,0,0" Width="300" Height="45" Click="NakladnyeBTN_Click"/>
        <Button x:Name="ReportBTN" Content="Отчет по складу" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,340,0,0" Width="300" Height="45" Click="ReportBTN_Click"/>
        <Button x:Name="UsersBTN" Content="Сотрудники" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,400,0,0" Width="300" Height="45" Click="UsersBTN_Click"/>
        <Button x:Name="ExitBTN" Content="Выход" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,520,0,0" Width="180" Height="45" Click="ExitBTN_Click"/>
    </Grid>
</Window>