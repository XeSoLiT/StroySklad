<Window x:Class="WpfApp1.Materials"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Materials" Height="850" Width="1100" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <DataGrid x:Name="MaterialsDataGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,25,0,0" Width="1050" Height="500" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MaterialsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding naimenovanie}" Width="350"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding cena}" Width="100"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding kolichestvo}" Width="100"/>
                <DataGridTemplateColumn Header="Фото" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Width="100" Height="100" Stretch="Uniform" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Label Content="Наименование:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,550,0,0"/>
        <TextBox x:Name="NaimenovanieBOX" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,580,0,0" Width="250" Height="35"/>

        <Label Content="Цена:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,550,0,0"/>
        <TextBox x:Name="CenaBOX" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,580,0,0" Width="120" Height="35"/>

        <Label Content="Количество:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="445,550,0,0"/>
        <TextBox x:Name="KolichestvoBOX" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="445,580,0,0" Width="120" Height="35"/>

        <Label Content="ID Ед. изм:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="590,550,0,0"/>
        <TextBox x:Name="EdIzmBOX" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="590,580,0,0" Width="100" Height="35"/>

        <Label Content="ID Производителя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="715,550,0,0"/>
        <TextBox x:Name="ProizvoditelBOX" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="715,580,0,0" Width="100" Height="35"/>

        <Button x:Name="AddBTN" Content="Добавить" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,660,0,0" Width="180" Height="45" Click="AddBTN_Click"/>
        <Button x:Name="UpdateBTN" Content="Изменить" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="400,660,0,0" Width="180" Height="45" Click="UpdateBTN_Click"/>
        <Button x:Name="DeleteBTN" Content="Удалить" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="600,660,0,0" Width="180" Height="45" Click="DeleteBTN_Click"/>
        <Button x:Name="BackBTN" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="800,660,0,0" Width="180" Height="45" Background="Transparent" Foreground="#4F46E5" Click="BackBTN_Click"/>
    </Grid>
</Window>