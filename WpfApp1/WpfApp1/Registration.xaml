<Window x:Class="WpfApp1.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Registration" Height="650" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Label Content="Фамилия" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"/>
        <TextBox x:Name="FamiliyaBOX" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" Width="280" Height="40"/>
        <Label Content="Имя" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,130,0,0"/>
        <TextBox x:Name="ImyaBOX" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0" Width="280" Height="40"/>
        <Label Content="Отчество" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,210,0,0"/>
        <TextBox x:Name="OtchestvoBOX" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,240,0,0" Width="280" Height="40"/>
        <Label Content="Логин" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,290,0,0"/>
        <TextBox x:Name="LoginBOX" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,320,0,0" Width="280" Height="40"/>
        <Label Content="Пароль" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,370,0,0"/>
        <PasswordBox x:Name="ParolBOX" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,400,0,0" Width="280" Height="40"/>
        <Button x:Name="RegBTN" Content="Зарегистрироваться" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,480,0,0" Width="250" Height="45" Click="RegBTN_Click"/>
        <Button x:Name="BackBTN" Content="Назад" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,550,0,0" Width="150" Height="35" Background="Transparent" Foreground="#4F46E5" Click="BackBTN_Click"/>
    </Grid>
</Window>