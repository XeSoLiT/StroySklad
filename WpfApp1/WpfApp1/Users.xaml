<Window x:Class="WpfApp1.Users"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Users" Height="600" Width="900" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <DataGrid x:Name="UsersDataGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,25,0,0" Width="850" Height="450" AutoGenerateColumns="True" IsReadOnly="True"/>
        <Button x:Name="BackBTN" Content="Назад" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,520,0,0" Width="150" Height="40" Background="Transparent" Foreground="#4F46E5" Click="BackBTN_Click"/>
    </Grid>
</Window>